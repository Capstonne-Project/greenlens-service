{
  "ConnectionStrings": {
    "Redis": "localhost:6379"
  },
  "Redis": {
    "Required": false
  },
  "ApiRateLimit": {
    "AnonymousPermitLimit": 60,
    "AuthenticatedPermitLimit": 300,
    "WindowSeconds": 60,
    "SegmentsPerWindow": 6
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "WorkloadLimits": {
    "MaxTasksPerTeam": 6,
    "WarningThreshold": 5
  },
  "Gemini": {
    "ApiKey": "",
    "Model": "gemini-2.5-flash"
  },
  "Meta": {
    "AppId": "",
    "AppSecret": "",
    "PageId": "",
    "PageAccessToken": "",
    "AutoPostEnabled": false,
    "GraphApiVersion": "v26.0"
  }
}
