# Copy to .env at repo root:  cp .env.example .env
# Loaded automatically on startup via DotEnvLoader (before WebApplication.CreateBuilder).
# Env vars override appsettings.Development.json placeholders.

ASPNETCORE_ENVIRONMENT=Development

# ── Database ─────────────────────────────────────────
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=greenlens_dev;Username=postgres;Password=YOUR_PASSWORD

# ── JWT ──────────────────────────────────────────────
Jwt__Secret=YOUR_JWT_SECRET_AT_LEAST_32_CHARS
Jwt__Issuer=GreenLens
Jwt__Audience=GreenLens
Jwt__AccessTokenExpirationHours=24
Jwt__RefreshTokenExpirationDays=30

# ── SMTP ─────────────────────────────────────────────
Smtp__Host=smtp.gmail.com
Smtp__Port=587
Smtp__Username=your@gmail.com
Smtp__Password=your_app_password
Smtp__FromEmail=noreply@greenlens.com.vn
Smtp__FromName=GreenLens
Smtp__EnableSsl=true

# ── Cloudflare R2 ────────────────────────────────────
R2__AccountId=YOUR_R2_ACCOUNT_ID
R2__AccessKeyId=YOUR_R2_ACCESS_KEY
R2__SecretAccessKey=YOUR_R2_SECRET_KEY
R2__BucketName=greenlens
R2__PublicUrl=https://pub-XXXX.r2.dev

# ── Firebase Admin SDK ───────────────────────────────
# Place the JSON file in src/Greenlens.Api/ (gitignored). Filename must match below.
Firebase__ServiceAccountKeyPath=your-project-firebase-adminsdk-xxxxx.json

# ── AI service (optional) ────────────────────────────
Ai__BaseUrl=http://localhost:8000
Ai__TimeoutSeconds=30

# ── Public Next.js portal (community cleanup share / OG links) ──
# Origin ONLY — no trailing slash, no /officer/... path.
# ASP.NET maps PublicWeb__* → PublicWeb:* (see DotEnvLoader).
#
# Dev (Next.js local):
PublicWeb__BaseUrl=http://localhost:3000
#
# Production (Vercel — same origin as LEO portal, different public route):
# PublicWeb__BaseUrl=https://greenlens-portal.vercel.app
#
# Public landing for Facebook OG (Next.js must implement this route, no auth):
PublicWeb__CommunityCleanupPathTemplate=/c/community/{eventId}

# ── Meta Facebook Page auto-post (optional) ──────────
# Server-side only — never expose PageAccessToken to FE / Vercel.
# Meta__PageId=642977455573500
# Meta__PageAccessToken=YOUR_PAGE_ACCESS_TOKEN
# Meta__AppId=YOUR_META_APP_ID
# Meta__AppSecret=YOUR_META_APP_SECRET
# Bật API đăng lên Page khi LEO bấm nút Facebook trong dialog chia sẻ (không tự đăng khi create).
Meta__AutoPostEnabled=false
Meta__GraphApiVersion=v26.0
